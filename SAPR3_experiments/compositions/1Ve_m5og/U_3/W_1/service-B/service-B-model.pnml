<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<pnml>
    <net type="http://www.pnml.org/version-2009/grammar/petrinet">
        <arc source="1in" target="1" id="1in-1"/>
        <arc source="1" target="1out" id="1-1out"/>
        <arc source="start" target="ht0" id="start-ht0"/>
        <arc source="ht3" target="s0p" id="ht3-s0p"/>
        <arc source="1out" target="ht3" id="1out-ht3"/>
        <arc source="ht0" target="1in" id="ht0-1in"/>
        <place id="s0p">
            <name>
                <text>s0p</text>
            </name>
        </place>
        <place id="1in">
            <name>
                <text>1in</text>
            </name>
        </place>
        <place id="1out">
            <name>
                <text>1out</text>
            </name>
        </place>
        <place id="start">
            <name>
                <text>start</text>
            </name>
            <initialMarking>
                <text>1</text>
            </initialMarking>
        </place>
        <toolspecific tool="nl.rug.ds.bpm.ptnet" version="1.0">
            <process>
                <groups/>
                <roles/>
                <variables/>
            </process>
        </toolspecific>
        <transition id="1">
            <name>
                <text>1</text>
            </name>
        </transition>
        <transition id="ht3">
            <name>
                <text>ht3</text>
            </name>
        </transition>
        <transition id="ht0">
            <name>
                <text>ht0</text>
            </name>
        </transition>
    </net>
</pnml>
