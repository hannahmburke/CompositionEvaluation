<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<pnml>
    <net type="http://www.pnml.org/version-2009/grammar/petrinet">
        <arc source="3out" target="5" id="3out-5"/>
        <arc source="5" target="2p" id="5-2p"/>
        <arc source="start" target="3" id="start-3"/>
        <arc source="3" target="3out" id="3-3out"/>
        <place id="2p">
            <name>
                <text>2p</text>
            </name>
        </place>
        <place id="start">
            <name>
                <text>start</text>
            </name>
            <initialMarking>
                <text>1</text>
            </initialMarking>
        </place>
        <place id="3out">
            <name>
