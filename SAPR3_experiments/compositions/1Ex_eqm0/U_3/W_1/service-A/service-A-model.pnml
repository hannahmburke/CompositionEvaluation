<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<pnml>
    <net type="http://www.pnml.org/version-2009/grammar/petrinet">
        <arc source="ht1" target="3p" id="ht1-3p"/>
        <arc source="start" target="4" id="start-4"/>
        <arc source="4" target="4out" id="4-4out"/>
        <arc source="4out" target="ht1" id="4out-ht1"/>
        <place id="start">
            <name>
                <text>start</text>
            </name>
            <initialMarking>
                <text>1</text>
            </initialMarking>
        </place>
        <place id="4out">
            <name>
                <text>4out</text>
            </name>
        </place>
        <place id="3p">
            <name>
                <text>3p</text>
            </name>
        </place>
        <toolspecific tool="nl.rug.ds.bpm.ptnet" version="1.0">
            <process>
                <groups/>
                <roles/>
                <variables/>
            </process>
        </toolspecific>
        <transition id="ht1">
            <name>
                <text>ht1</text>
            </name>
        </transition>
        <transition id="4">
            <name>
                <text>4</text>
            </name>
        </transition>
    </net>
</pnml>
