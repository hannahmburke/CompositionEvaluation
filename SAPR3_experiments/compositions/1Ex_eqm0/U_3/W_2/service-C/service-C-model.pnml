<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<pnml>
    <net type="http://www.pnml.org/version-2009/grammar/petrinet">
        <arc source="ht0" target="2in" id="ht0-2in"/>
        <arc source="2in" target="2" id="2in-2"/>
        <arc source="start" target="ht0" id="start-ht0"/>
        <arc source="2" target="2out" id="2-2out"/>
        <place id="2in">
            <name>
                <text>2in</text>
            </name>
        </place>
        <place id="start">
            <name>
                <text>start</text>
            </name>
            <initialMarking>
                <text>1</text>
            </initialMarking>
        </place>
        <place id="2out">
            <name>
                <text>2out</text>
            </name>
        </place>
        <toolspecific tool="nl.rug.ds.bpm.ptnet" version="1.0">
            <process>
                <groups/>
                <roles/>
                <variables/>
            </process>
        </toolspecific>
        <transition id="ht0">
            <name>
                <text>ht0</text>
            </name>
        </transition>
        <transition id="2">
            <name>
                <text>2</text>
            </name>
        </transition>
    </net>
</pnml>
