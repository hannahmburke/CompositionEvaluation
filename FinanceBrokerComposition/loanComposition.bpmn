    <bpmn:startEvent id="Detail_3_Start">
      <bpmn:outgoing>Detail_3_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Detail_3_Task_1" name="Assemble loan application">
