  </bpmn:process>
  <bpmn:process id="Process_Detail_4" name="CBA enquiry" isExecutable="false">
    <bpmn:startEvent id="Detail_4_Start">
      <bpmn:outgoing>Detail_4_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Detail_4_Task_1" name="Validate quote inputs">
      <bpmn:documentation>Check loanAmount &gt; 0, paymentTerm &gt; 0, and creditScore is present.</bpmn:documentation>
      <bpmn:incoming>Detail_4_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Detail_4_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Detail_4_Task_2" name="Retrieve CBA product pricing">
      <bpmn:documentation>Select the CBA product and obtain its current base annual rate and eligibility rules.</bpmn:documentation>
      <bpmn:incoming>Detail_4_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Detail_4_Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Detail_4_Task_3" name="Apply CBA risk pricing">
      <bpmn:documentation>Illustrative rule: creditScore ≥ 750 adds 0.00%; 650–749 adds 0.50%; 550–649 adds 1.25%. Below 550, route for manual review. annualRate = CBA base rate + risk margin.</bpmn:documentation>
      <bpmn:incoming>Detail_4_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Detail_4_Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Detail_4_Task_4" name="Calculate monthly repayment">
      <bpmn:documentation>Let r = annualRate / 12 and n = paymentTerm in months. If r &gt; 0, monthlyPayment = loanAmount × r × (1+r)^n / ((1+r)^n − 1); if r = 0, monthlyPayment = loanAmount / n.</bpmn:documentation>
      <bpmn:incoming>Detail_4_Flow_4</bpmn:incoming>
      <bpmn:outgoing>Detail_4_Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Detail_4_Task_5" name="Return CBA quote">
      <bpmn:documentation>Return annualRate, monthlyPayment, selected CBA product, and pricing assumptions.</bpmn:documentation>
      <bpmn:incoming>Detail_4_Flow_5</bpmn:incoming>
      <bpmn:outgoing>Detail_4_Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Detail_4_End">
      <bpmn:incoming>Detail_4_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Detail_4_Flow_1" sourceRef="Detail_4_Start" targetRef="Detail_4_Task_1" />
    <bpmn:sequenceFlow id="Detail_4_Flow_2" sourceRef="Detail_4_Task_1" targetRef="Detail_4_Task_2" />
    <bpmn:sequenceFlow id="Detail_4_Flow_3" sourceRef="Detail_4_Task_2" targetRef="Detail_4_Task_3" />
    <bpmn:sequenceFlow id="Detail_4_Flow_4" sourceRef="Detail_4_Task_3" targetRef="Detail_4_Task_4" />
    <bpmn:sequenceFlow id="Detail_4_Flow_5" sourceRef="Detail_4_Task_4" targetRef="Detail_4_Task_5" />
    <bpmn:sequenceFlow id="Detail_4_Flow_6" sourceRef="Detail_4_Task_5" targetRef="Detail_4_End" />
  </bpmn:process>
