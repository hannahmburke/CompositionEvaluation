    <bpmn:textAnnotation id="CBA_Repayment">
      <bpmn:text>monthlyRate = CBAInterestRate / 12
n = paymentTerm
CBAmonthlyPayment = loanAmount × monthlyRate × (1+monthlyRate)^n / ((1+monthlyRate)^n − 1)
If monthlyRate = 0: loanAmount / n</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Rate_StandardVariable">
      <bpmn:text>CBAinterestRate = 4.5 + riskMargin.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0wi5sk3">
      <bpmn:text>riskMargin = null
monthlyRate = null
n = null</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11v81zx">
      <bpmn:text>riskMargin = max(0, 100 − creditScore) × 0.006</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ah437i">
      <bpmn:text>CBAinterestRate = 5.0 + riskMargin</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1i6v2if" associationDirection="None" sourceRef="Activity_0s32r0l" targetRef="TextAnnotation_11v81zx" />
