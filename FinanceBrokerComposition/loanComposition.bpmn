    <bpmn:textAnnotation id="TextAnnotation_0txr84p">
      <bpmn:text>creditScore = round(10 × (0.40 × paymentHistoryScore + 0.35 × utilizationScore + 0.25 × creditAgeScore))</bpmn:text>
