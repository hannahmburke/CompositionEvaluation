    <bpmn:task id="Detail_3_Task_3" name="Record request reference">
      <bpmn:incoming>Detail_3_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Detail_3_Flow_4</bpmn:outgoing>
    </bpmn:task>
