    <bpmn:sequenceFlow id="NAB_f5" sourceRef="NAB_CalculatePayment" targetRef="NAB_Approved">
      <bpmn:categoryValueRef>CategoryValue_05azlas</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NAB_f1" sourceRef="NAB_Start" targetRef="NAB_CreditGate">
      <bpmn:categoryValueRef>CategoryValue_05azlas</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="ANZ_ProductChoice" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1t77rd6</bpmn:incoming>
      <bpmn:outgoing>ANZ_FixedPath</bpmn:outgoing>
      <bpmn:outgoing>ANZ_VariablePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ANZ_ProductMerge" gatewayDirection="Converging">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_FixedMerge</bpmn:incoming>
      <bpmn:incoming>ANZ_VariableMerge</bpmn:incoming>
      <bpmn:outgoing>ANZ_ProductMergeToPayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ANZ_OffsetGate">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_f4</bpmn:incoming>
      <bpmn:outgoing>ANZ_Yes</bpmn:outgoing>
      <bpmn:outgoing>ANZ_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ANZ_OffsetMerge">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_YesMerge</bpmn:incoming>
      <bpmn:incoming>ANZ_NoMerge</bpmn:incoming>
      <bpmn:outgoing>ANZ_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ANZ_End">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_08k2d42" name="Local variables">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_1kibgz5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1t77rd6" sourceRef="Activity_116v1md" targetRef="ANZ_ProductChoice">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_FixedPath" sourceRef="ANZ_ProductChoice" targetRef="ANZ_FixedRate">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anzProductType == 'FIXED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_VariablePath" sourceRef="ANZ_ProductChoice" targetRef="ANZ_VariableRate">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${anzProductType == 'VARIABLE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_FixedMerge" sourceRef="ANZ_FixedRate" targetRef="ANZ_ProductMerge">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_VariableMerge" sourceRef="ANZ_VariableRate" targetRef="ANZ_ProductMerge">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_ProductMergeToPayment" sourceRef="ANZ_ProductMerge" targetRef="ANZ_BasePayment">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_f4" sourceRef="ANZ_BasePayment" targetRef="ANZ_OffsetGate">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_Yes" sourceRef="ANZ_OffsetGate" targetRef="ANZ_AddFee">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${offsetSelected == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_No" sourceRef="ANZ_OffsetGate" targetRef="ANZ_NoFee">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${offsetSelected == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_YesMerge" sourceRef="ANZ_AddFee" targetRef="ANZ_OffsetMerge">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_NoMerge" sourceRef="ANZ_NoFee" targetRef="ANZ_OffsetMerge">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ANZ_f5" sourceRef="ANZ_OffsetMerge" targetRef="ANZ_End">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1kibgz5" sourceRef="Event_08k2d42" targetRef="Activity_116v1md">
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:startEvent id="Event_0vzbie2">
      <bpmn:categoryValueRef>CategoryValue_15tbae6</bpmn:categoryValueRef>
      <bpmn:outgoing>Flow_0fx17l2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_0gytfbp">
      <bpmn:categoryValueRef>CategoryValue_15tbae6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_18mea6u</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0fx17l2" sourceRef="Event_0vzbie2" targetRef="Activity_14qnlvp">
      <bpmn:categoryValueRef>CategoryValue_15tbae6</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0fzmyxl" sourceRef="Activity_14qnlvp" targetRef="Activity_1r8n1fx">
      <bpmn:categoryValueRef>CategoryValue_15tbae6</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18mea6u" sourceRef="Activity_1r8n1fx" targetRef="Event_0gytfbp">
      <bpmn:categoryValueRef>CategoryValue_15tbae6</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:task id="NAB_CalculatePayment" name="Calculate monthly repayment">
      <bpmn:documentation>Use global loanAmount and paymentTerm and the selected product interestRate. Set local monthlyRate = interestRate / 12 and n = paymentTerm. If monthlyRate &gt; 0, monthlyPayment = loanAmount × monthlyRate × (1+monthlyRate)^n / ((1+monthlyRate)^n − 1); otherwise monthlyPayment = loanAmount / n.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_05azlas</bpmn:categoryValueRef>
      <bpmn:incoming>NAB_f4</bpmn:incoming>
      <bpmn:outgoing>NAB_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="NAB_Fixed" name="NAB fixed-rate product">
      <bpmn:documentation>For the selected fixed-rate product, use its NAB fixedBaseRate as local interestRate. No score-based risk margin is applied.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_05azlas</bpmn:categoryValueRef>
      <bpmn:incoming>NAB_fixed</bpmn:incoming>
      <bpmn:outgoing>NAB_fixed_merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="NAB_Variable" name="NAB variable product">
      <bpmn:documentation>For the selected variable product, use its NAB variableBaseRate as local interestRate. No score-based risk margin is applied.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_05azlas</bpmn:categoryValueRef>
      <bpmn:incoming>NAB_var</bpmn:incoming>
      <bpmn:outgoing>NAB_var_merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="NAB_RetrieveProducts" name="Retrieve eligible NAB products">
      <bpmn:documentation>Use global creditScore to determine eligibility. Below 550 the process declines. Otherwise retrieve eligible NAB products and their product-specific base rates. Set local nabProductType to the selected offer type.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_05azlas</bpmn:categoryValueRef>
      <bpmn:incoming>NAB_accept</bpmn:incoming>
      <bpmn:outgoing>NAB_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ANZ_AddFee" name="Add offset account fee">
      <bpmn:documentation>Retrieve local offsetMonthlyFee from ANZ product pricing. Set local monthlyRepayment = basePayment + offsetMonthlyFee.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_Yes</bpmn:incoming>
      <bpmn:outgoing>ANZ_YesMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ANZ_NoFee" name="Keep base repayment">
      <bpmn:documentation>Set local monthlyRepayment = basePayment.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_No</bpmn:incoming>
      <bpmn:outgoing>ANZ_NoMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ANZ_BasePayment" name="Calculate base repayment">
      <bpmn:documentation>Use global loanAmount and paymentTerm with local annualRate. Set local monthlyRate = annualRate / 12 and n = paymentTerm (months). If monthlyRate &gt; 0, basePayment = loanAmount × monthlyRate × (1+monthlyRate)^n / ((1+monthlyRate)^n − 1); otherwise basePayment = loanAmount / n.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_ProductMergeToPayment</bpmn:incoming>
      <bpmn:outgoing>ANZ_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ANZ_FixedRate" name="Select fixed-rate offer">
      <bpmn:documentation>Set local annualRate to the selected ANZ fixed product rate.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_FixedPath</bpmn:incoming>
      <bpmn:outgoing>ANZ_FixedMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ANZ_VariableRate" name="Select variable-rate offer">
      <bpmn:documentation>Set local annualRate to the selected ANZ variable product rate.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>ANZ_VariablePath</bpmn:incoming>
      <bpmn:outgoing>ANZ_VariableMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_116v1md" name="Calculate risk margin">
      <bpmn:documentation>Use global creditScore. If creditScore &lt; 550, route for manual review; otherwise calculate local riskMargin = max(0, 750 − creditScore) × 0.005 percentage points.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0xynu46</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1kibgz5</bpmn:incoming>
      <bpmn:outgoing>Flow_1t77rd6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CBA_StandardVariable" name="Standard variable product">
      <bpmn:documentation>Get local variableBaseRate from the selected eligible CBA offer. Set local baseRate = variableBaseRate, then local interestRate = baseRate + riskMargin.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0ws4nt1</bpmn:categoryValueRef>
      <bpmn:incoming>CBA_Product_1</bpmn:incoming>
      <bpmn:outgoing>CBA_Merge_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CBA_FixedRate" name="Fixed-rate product">
      <bpmn:documentation>Get local fixedBaseRate from the selected eligible CBA offer. Set local baseRate = fixedBaseRate, then local interestRate = baseRate + riskMargin.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0ws4nt1</bpmn:categoryValueRef>
      <bpmn:incoming>CBA_Product_2</bpmn:incoming>
      <bpmn:outgoing>CBA_Merge_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CBA_CalculatePayment" name="Calculate monthly repayment">
      <bpmn:documentation>Use global loanAmount and paymentTerm with the selected product interestRate. Set local monthlyRate = interestRate / 12 and n = paymentTerm (months). If monthlyRate &gt; 0, monthlyPayment = loanAmount × monthlyRate × (1+monthlyRate)^n / ((1+monthlyRate)^n − 1); otherwise monthlyPayment = loanAmount / n.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0ws4nt1</bpmn:categoryValueRef>
      <bpmn:incoming>CBA_ToPayment</bpmn:incoming>
      <bpmn:outgoing>CBA_ToQuote</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0s32r0l" name="Calculate risk margin">
      <bpmn:documentation>Use global creditScore. If creditScore &lt; 550, route for manual review; otherwise calculate local riskMargin = max(0, 750 − creditScore) × 0.005 percentage points.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_0ws4nt1</bpmn:categoryValueRef>
      <bpmn:incoming>CBA_Flow_Start</bpmn:incoming>
      <bpmn:outgoing>CBA_Flow_Pricing</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Reject" name="Quit">
      <bpmn:documentation>accActive := false</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_199nbp3</bpmn:categoryValueRef>
      <bpmn:incoming>f_select_reject</bpmn:incoming>
      <bpmn:outgoing>f_reject_outcome</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ClearData" name="Clear data">
      <bpmn:documentation>idPoints := 0; pDoc := 0; sDoc := 0</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_199nbp3</bpmn:categoryValueRef>
      <bpmn:incoming>f_outcome_clear</bpmn:incoming>
      <bpmn:outgoing>f_clear_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CalculateAge" name="Calculate age">
      <bpmn:documentation>age := [0, 125]</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_199nbp3</bpmn:categoryValueRef>
      <bpmn:incoming>f_check_age</bpmn:incoming>
      <bpmn:outgoing>Flow_11opfvo</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Primary" name="Primary document">
      <bpmn:documentation>idPoints += 70; pDoc += 1</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_199nbp3</bpmn:categoryValueRef>
      <bpmn:incoming>f_select_primary</bpmn:incoming>
      <bpmn:outgoing>f_primary_merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Secondary" name="Secondary document">
      <bpmn:documentation>idPoints += {25, 35, 40}; sDoc += 1</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_199nbp3</bpmn:categoryValueRef>
      <bpmn:incoming>f_select_secondary</bpmn:incoming>
      <bpmn:outgoing>f_secondary_merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0bzrxy8" name="Collect credit factors">
      <bpmn:documentation>Collect three normalized local factor scores.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_052zufi</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_0ibu91j</bpmn:incoming>
      <bpmn:outgoing>Flow_13hoywn</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_081sius" name="Calculate credit score">
      <bpmn:documentation>Calculate and store the single output value creditScore.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_052zufi</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_13hoywn</bpmn:incoming>
      <bpmn:outgoing>Flow_1mnryuc</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_1kpgf64" name="Clear factor data">
      <bpmn:documentation>Set paymentHistoryScore, utilizationScore, and creditAgeScore to null. Preserve creditScore.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_052zufi</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1mnryuc</bpmn:incoming>
      <bpmn:outgoing>Flow_1isbv7o</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0j20jim" name="Payment term">
      <bpmn:documentation>Calculate and store the single output value creditScore.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1pb8qm4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1gpphse</bpmn:incoming>
      <bpmn:outgoing>Flow_1lhonuv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_023bszx" name="Loan amount">
      <bpmn:documentation>Calculate and store the single output value creditScore.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1pb8qm4</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_1alg7tt</bpmn:incoming>
      <bpmn:outgoing>Flow_1gpphse</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_1r8n1fx" name="Clear quotes">
      <bpmn:documentation>Calculate and store the single output value creditScore.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_15tbae6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_0fzmyxl</bpmn:incoming>
      <bpmn:outgoing>Flow_18mea6u</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_14qnlvp" name="Reduce loan amount">
      <bpmn:documentation>Calculate and store the single output value creditScore.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_15tbae6</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_0fx17l2</bpmn:incoming>
      <bpmn:outgoing>Flow_0fzmyxl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="DS_Start" name="Local variables">
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:outgoing>DS_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="DS_Split" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_f3</bpmn:incoming>
      <bpmn:outgoing>DS_borrower</bpmn:outgoing>
      <bpmn:outgoing>DS_bank</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="DS_Join" gatewayDirection="Converging">
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_borrower_join</bpmn:incoming>
      <bpmn:incoming>DS_bank_join</bpmn:incoming>
      <bpmn:outgoing>DS_f4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="DS_End">
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>Flow_09ca2e2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="DS_BorrowerID" name="Verify borrower identity">
      <bpmn:documentation>After the borrower identity challenge succeeds, record envelopeId.borrower.identity := VERIFIED. Enable the signature step only on success.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_borrower</bpmn:incoming>
      <bpmn:outgoing>DS_borrower_sign</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DS_BankID" name="Verify bank representative identity">
      <bpmn:documentation>Resolve an authorized representative for selectedBank. After identity and authority checks succeed, record envelopeId.bankSigner.identity := VERIFIED.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_bank</bpmn:incoming>
      <bpmn:outgoing>DS_bank_sign</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DS_Protect" name="Hash source and create envelope">
      <bpmn:documentation>Compute sourceHash := SHA-256(signingDocument bytes). Create and send the envelope with signingDocument; set envelopeId to the returned envelope. The source hash is for the unsigned document and is not expected to match the signed PDF.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_f2</bpmn:incoming>
      <bpmn:outgoing>DS_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DS_Prepare" name="Prepare document">
      <bpmn:documentation>Read global selectedBank, approvedOffer, and borrowerDetails. Set local signingDocument := approvedOffer.document. Resolve the bank representative from selectedBank for the envelope recipients.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_f1</bpmn:incoming>
      <bpmn:outgoing>DS_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DS_BorrowerSign" name="Borrower signs agreement">
      <bpmn:documentation>Capture the borrower signature in the envelope: envelopeId.borrower.signature := SIGNED; envelopeId.borrower.signedAt := envelope timestamp.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_borrower_sign</bpmn:incoming>
      <bpmn:outgoing>DS_borrower_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DS_BankSign" name="Selected bank representative signs">
      <bpmn:documentation>Capture the bank signature in the envelope: envelopeId.bankSigner.signature := SIGNED; envelopeId.bankSigner.signedAt := envelope timestamp.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_bank_sign</bpmn:incoming>
      <bpmn:outgoing>DS_bank_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DS_Verify" name="Verify and securely archive completed envelope">
      <bpmn:documentation>Confirm the envelope is complete and both signer records are verified and signed. Retrieve signedDocument; compute signedHash := SHA-256(signedDocument bytes). If archiving encrypted, set archiveCiphertext := encrypt(signedDocument, archive key). On later retrieval, decrypt with the authorized key and verify SHA-256(decrypted PDF) = signedHash.</bpmn:documentation>
      <bpmn:categoryValueRef>CategoryValue_1v6aogg</bpmn:categoryValueRef>
      <bpmn:incoming>DS_f4</bpmn:incoming>
      <bpmn:outgoing>DS_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0u3fui9" name="Loan complete">
      <bpmn:documentation>Confirm the envelope is complete and both signer records are verified and signed. Retrieve signedDocument; compute signedHash := SHA-256(signedDocument bytes). If archiving encrypted, set archiveCiphertext := encrypt(signedDocument, archive key). On later retrieval, decrypt with the authorized key and verify SHA-256(decrypted PDF) = signedHash.</bpmn:documentation>
