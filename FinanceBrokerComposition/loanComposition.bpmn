    <bpmn:group id="Group_1cgrqaq" categoryValueRef="CategoryValue_05azlas" />
    <bpmn:textAnnotation id="TextAnnotation_05dossp">
      <bpmn:text>NABinterestRate = variableBaseRate</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ANZ_RepaymentFormula">
      <bpmn:text>monthlyRate = ANZinterestRate / 12
n = paymentTerm
